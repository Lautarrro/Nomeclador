@page
@model Nomenclador.Web.Pages.Cuenta.CambiarClaveModel
@{ ViewData["Title"] = "Cambiar clave"; }

<div class="row justify-content-center mt-4">
    <div class="col-sm-8 col-md-5 col-lg-4">
        <div class="tarjeta">
            <h1 class="h4 mb-3">Cambiar clave</h1>
            @if (Model.Obligatorio)
            {
                <div class="alert alert-warning py-2">Estás usando una clave temporal. Elegí una nueva para continuar.</div>
            }
            <form method="post">
                <div class="mb-3">
                    <label asp-for="Actual" class="form-label">Clave actual</label>
                    <input asp-for="Actual" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Actual" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Nueva" class="form-label">Clave nueva</label>
                    <input asp-for="Nueva" class="form-control" autocomplete="new-password" />
                    <div class="form-text">Mínimo @ServicioUsuarios.LargoMinimoClave caracteres.</div>
                    <span asp-validation-for="Nueva" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Repetir" class="form-label">Repetir clave nueva</label>
                    <input asp-for="Repetir" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Repetir" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Guardar</button>
            </form>
        </div>
    </div>
</div>
