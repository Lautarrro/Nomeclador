@page
@model Nomenclador.Web.Pages.Cuenta.IngresarModel
@{ ViewData["Title"] = "Ingresar"; }

<div class="row justify-content-center mt-5">
    <div class="col-sm-8 col-md-5 col-lg-4">
        <div class="tarjeta">
            <h1 class="h4 mb-3">Ingresar al Nomenclador</h1>
            @if (Model.Error is not null)
            {
                <div class="alert alert-danger py-2" role="alert">@Model.Error</div>
            }
            <form method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="mb-3">
                    <label asp-for="Usuario" class="form-label">Usuario</label>
                    <input asp-for="Usuario" class="form-control" autocomplete="username" autofocus />
                    <span asp-validation-for="Usuario" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Clave" class="form-label">Clave</label>
                    <input asp-for="Clave" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Clave" class="text-danger small"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="Recordar" class="form-check-input" />
                    <label asp-for="Recordar" class="form-check-label">Mantener la sesión abierta</label>
                </div>
                <button type="submit" class="btn btn-primary w-100">Ingresar</button>
            </form>
            <p class="small text-muted mt-3 mb-0">¿No tenés usuario? Pedíselo al administrador.</p>
        </div>
    </div>
</div>
