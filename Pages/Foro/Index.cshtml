@page
@model Nomenclador.Web.Pages.Foro.IndexModel
@{ ViewData["Title"] = "Foro"; }

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0 me-3">Foro</h1>
    <form method="get" class="d-flex gap-2 flex-wrap">
        <select name="categoria" class="form-select form-select-sm w-auto" onchange="this.form.submit()" aria-label="Categoría">
            <option value="">Todas las categorías</option>
            @foreach (var c in CategoriasForo.Todas)
            {
                <option selected="@(c == Model.Categoria)">@c</option>
            }
        </select>
        <input name="q" value="@Model.Q" class="form-control form-control-sm w-auto" placeholder="Buscar en el foro" aria-label="Buscar en el foro" />
        @if (!string.IsNullOrEmpty(Model.Codigo))
        {
            <input type="hidden" name="codigo" value="@Model.Codigo" />
            <span class="badge text-bg-light align-self-center">Código @Model.Codigo <a asp-page="/Foro/Index" class="ms-1">✕</a></span>
        }
        <button class="btn btn-sm btn-outline-secondary" type="submit">Buscar</button>
    </form>
    <a class="btn btn-primary btn-sm ms-auto" asp-page="/Foro/Nuevo">Nuevo tema</a>
</div>

<div class="tarjeta p-0">
    <table class="table table-hover mb-0">
        <thead class="table-light">
            <tr><th>Tema</th><th class="d-none d-md-table-cell">Categoría</th><th class="num">Respuestas</th><th class="d-none d-md-table-cell">Última actividad</th></tr>
        </thead>
        <tbody>
            @if (Model.Temas.Count == 0)
            {
                <tr><td colspan="4" class="text-center text-muted py-4">Todavía no hay temas. Creá el primero con “Nuevo tema”.</td></tr>
            }
            @foreach (var t in Model.Temas)
            {
                <tr>
                    <td>
                        @if (t.Fijado) { <span class="badge text-bg-warning" title="Fijado">Fijado</span> }
                        @if (t.Cerrado) { <span class="badge text-bg-secondary">Cerrado</span> }
                        <a asp-page="/Foro/Tema" asp-route-id="@t.Id" class="fw-semibold">@t.Titulo</a>
                        @if (t.CodigoPractica is not null) { <span class="codigo small text-muted">· @t.CodigoPractica</span> }
                        <div class="small text-muted">por @t.Autor · @t.CreadoUtc.ToLocalTime().ToString("dd/MM/yyyy")</div>
                    </td>
                    <td class="d-none d-md-table-cell">@t.Categoria</td>
                    <td class="num">@t.Respuestas</td>
                    <td class="d-none d-md-table-cell small">@t.UltimaActividadUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
