@page
@model Nomenclador.Web.Pages.Foro.NuevoModel
@{ ViewData["Title"] = "Nuevo tema"; }

<div class="tarjeta" style="max-width: 900px">
    <h1 class="h4 mb-3">Nuevo tema</h1>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Titulo" class="form-label">Título</label>
            <input asp-for="Titulo" class="form-control" />
            <span asp-validation-for="Titulo" class="text-danger small"></span>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <label asp-for="Categoria" class="form-label">Categoría</label>
                <select asp-for="Categoria" class="form-select">
                    @foreach (var c in CategoriasForo.Todas)
                    {
                        if (c == "Novedades" && !User.EsAdmin()) continue;
                        <option>@c</option>
                    }
                </select>
                <span asp-validation-for="Categoria" class="text-danger small"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="Codigo" class="form-label">Código de práctica relacionado (opcional)</label>
                <input asp-for="Codigo" class="form-control codigo" placeholder="ej. 01.02.04" />
                <span asp-validation-for="Codigo" class="text-danger small"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Cuerpo" class="form-label">Mensaje</label>
            <textarea asp-for="Cuerpo" class="form-control" rows="10"></textarea>
            <span asp-validation-for="Cuerpo" class="text-danger small"></span>
        </div>
        @if (User.EsAdmin())
        {
            <div class="form-check mb-3">
                <input asp-for="Fijado" class="form-check-input" />
                <label asp-for="Fijado" class="form-check-label">Fijar arriba de todo</label>
            </div>
        }
        <button type="submit" class="btn btn-primary">Publicar</button>
        <a asp-page="/Foro/Index" class="btn btn-link">Cancelar</a>
    </form>
</div>
