<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Nomenclador</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-usuario="@User.Identity?.Name">
    @{
        var autenticado = User.Identity?.IsAuthenticated == true;
        var pagina = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
        string Activo(string prefijo) => pagina.StartsWith(prefijo) ? "active" : "";
    }
    <header class="no-imprimir">
        <nav class="navbar navbar-expand-md navbar-dark barra">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-page="/Index">Nomenclador</a>
                @if (autenticado)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
                            aria-controls="menu" aria-expanded="false" aria-label="Menú">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="menu">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item"><a class="nav-link @(pagina == "/Index" ? "active" : "")" asp-page="/Index">Buscar</a></li>
                            <li class="nav-item"><a class="nav-link @Activo("/Calculadora")" asp-page="/Calculadora">Calculadora <span class="badge bg-light text-dark" id="contador-carrito"></span></a></li>
                            <li class="nav-item"><a class="nav-link @Activo("/Foro")" asp-page="/Foro/Index">Foro</a></li>
                            <li class="nav-item"><a class="nav-link @Activo("/Info")" asp-page="/Info">Cómo se calcula</a></li>
                            @if (User.EsAdmin())
                            {
                                <li class="nav-item"><a class="nav-link @Activo("/Admin")" asp-page="/Admin/Index">Administración</a></li>
                            }
                        </ul>
                        <div class="dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" data-bs-toggle="dropdown" aria-expanded="false">@User.NombreVisible()</a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-page="/Cuenta/CambiarClave">Cambiar clave</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form method="post" asp-page="/Cuenta/Salir">
                                        <button class="dropdown-item" type="submit">Salir</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                }
            </div>
        </nav>
    </header>

    <main class="container-fluid py-3 contenido">
        @if (TempData["Mensaje"] is string msg)
        {
            <div class="alert alert-success alert-dismissible fade show no-imprimir" role="status">
                @msg
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger alert-dismissible fade show no-imprimir" role="alert">
                @err
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
